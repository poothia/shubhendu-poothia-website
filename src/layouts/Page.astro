---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  wide?: boolean;
}

const { title, description, ogImage, wide = false } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage}>
  <Nav />
  <main class:list={['page-main', { 'page-main--wide': wide }]}>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .page-main {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-top: var(--space-xl);
    min-height: 60vh;
  }

  .page-main--wide {
    max-width: 100%;
    padding-inline: var(--gutter);
  }
</style>
